# Publish only the source, current binaries and minimal documentation below.
# Everything else remains local. Update the version paths for a new release.
/*
!/.gitignore
!/.gitattributes
!/.gitmodules
!/README.md
!/LICENSE
!/platformio.ini
!/requirements-dev.txt
!/open-x4-sdk/

# Firmware source
!/firmware/
/firmware/*
!/firmware/src/
/firmware/src/*
!/firmware/src/*.cpp
!/firmware/src/*.h

# Runtime driver modules and its dependency lists
!/pc_driver/
/pc_driver/*
!/pc_driver/__init__.py
!/pc_driver/amd_gpu.py
!/pc_driver/driver.py
!/pc_driver/protocol.py
!/pc_driver/network.py
!/pc_driver/sleep_image.py
!/pc_driver/tf.py
!/pc_driver/tray.py
!/pc_driver/requirements.txt
!/pc_driver/requirements-build.txt

# Required build hooks and SDK patch
!/scripts/
/scripts/*
!/scripts/apply_sdk_patch.py
!/scripts/archive_firmware.py
!/scripts/build_driver.py
!/patches/
/patches/*
!/patches/open-x4-sdk-sdcard-format.patch
!/patches/LICENSE-open-x4-sdk

# Current Windows EXE bundle supplied by the user
!/artifacts/
/artifacts/*
!/artifacts/pc-driver/
/artifacts/pc-driver/*
!/artifacts/pc-driver/20261016-233355/
/artifacts/pc-driver/20261016-233355/*
!/artifacts/pc-driver/20261016-233355/XTE-Link.exe
!/artifacts/pc-driver/20261016-233355/SHA256SUMS.txt
!/artifacts/pc-driver/20261016-233355/build-requirements.txt
!/artifacts/pc-driver/20261016-233355/使用说明.txt

# Current device application image
!/artifacts/firmware/
/artifacts/firmware/*
!/artifacts/firmware/sleep-image-20261016-225639/
/artifacts/firmware/sleep-image-20261016-225639/*
!/artifacts/firmware/sleep-image-20261016-225639/firmware.bin
!/artifacts/firmware/sleep-image-20261016-225639/SHA256SUMS.txt
!/artifacts/firmware/sleep-image-20261016-225639/manifest.json
!/artifacts/firmware/app-menu-half-20261017-132347/
/artifacts/firmware/app-menu-half-20261017-132347/*
!/artifacts/firmware/app-menu-half-20261017-132347/firmware.bin
!/artifacts/firmware/app-menu-half-20261017-132347/SHA256SUMS.txt
!/artifacts/firmware/app-menu-half-20261017-132347/manifest.json
