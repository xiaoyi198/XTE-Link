# Publish only the source, current binaries and minimal documentation below.
# Everything else remains local. Update the version paths for a new release.
/*
!/.gitignore
!/.gitattributes
!/.gitmodules
!/README.md
!/AGENTS.md
!/LICENSE
!/platformio.ini
!/requirements-dev.txt
!/PROTOCOL.md
!/TF_FILES.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/validate.yml

# Current specifications and guides; historical records live in the sibling backup folder.
!/docs/
/docs/*
!/docs/维护性修复计划-2026-10-19.md
!/docs/硬件契约-核实版.md
!/docs/按键方向约定.md
!/docs/维护性修复验证-2026-10-19.md
!/docs/归档说明.md
!/docs/设置中心.md
!/docs/开发环境.md
!/docs/DEPENDENCIES.md

!/open-x4-sdk/
!/third_party/
/third_party/*
!/third_party/esp32-ymodem

# Bundled sleep skins: device BMPs, previews, originals and reproducible metadata.
!/assets/
/assets/*
!/assets/sleep-skins/
/assets/sleep-skins/*
!/assets/sleep-skins/*.bmp
!/assets/sleep-skins/*.png
!/assets/sleep-skins/README.md
!/assets/sleep-skins/PROMPTS.md
!/assets/sleep-skins/manifest.json
!/assets/sleep-skins/SHA256SUMS.txt
!/assets/sleep-skins/originals/
/assets/sleep-skins/originals/*
!/assets/sleep-skins/originals/*.png

# Versioned UI artwork, pinned icon sources, exports and provenance.
!/assets/ui/
!/assets/ui/**

# Firmware source
!/firmware/
/firmware/*
!/firmware/src/
/firmware/src/*
!/firmware/src/*.cpp
!/firmware/src/*.h
!/firmware/FONTS.md
!/firmware/README.md
!/firmware/tests/
/firmware/tests/*
!/firmware/tests/*.py
!/firmware/tests/*.cpp
!/firmware/tests/*.h
!/firmware/tests/stubs/
!/firmware/tests/stubs/**

# Reproducible local MiSans conversion; font binaries stay under ignored artifacts/.
!/tools/
/tools/*
!/tools/misans/
/tools/misans/*
!/tools/misans/*.py
!/tools/misans/*.json
!/tools/misans/*.txt
!/tools/misans/*.md
!/tools/font_preview/
/tools/font_preview/*
!/tools/font_preview/*.py
!/tools/font_preview/*.html
!/tools/font_preview/*.md

# Runtime driver modules and its dependency lists
!/pc_driver/
/pc_driver/*
!/pc_driver/__init__.py
!/pc_driver/amd_gpu.py
!/pc_driver/driver.py
!/pc_driver/codex_ipc.py
!/pc_driver/clash_verge.py
!/pc_driver/clash_panel.py
!/pc_driver/windows_proxy.py
!/pc_driver/LICENSE-codex-mobile
!/pc_driver/protocol.py
!/pc_driver/network.py
!/pc_driver/sleep_image.py
!/pc_driver/tf.py
!/pc_driver/tray.py
!/pc_driver/install.py
!/pc_driver/install_window.py
!/pc_driver/flash.py
!/pc_driver/device_profiles.json
!/pc_driver/test_install.py
!/pc_driver/INSTALLER.md
!/pc_driver/test_tf.py
!/pc_driver/test_network.py
!/pc_driver/test_*.py
!/pc_driver/requirements.txt
!/pc_driver/requirements-build.txt

# Required build hooks and SDK patch
!/scripts/
/scripts/*
!/scripts/apply_sdk_patch.py
!/scripts/apply_ymodem_patch.py
!/scripts/archive_firmware.py
!/scripts/build_driver.py
!/scripts/prepare_driver_payload.py
!/scripts/check_build.py
!/scripts/check_dependencies.py
!/scripts/test_build.py
!/patches/
/patches/*
!/patches/open-x4-sdk-sdcard-format.patch
!/patches/open-x4-sdk-sdcard-space.patch
!/patches/LICENSE-open-x4-sdk
!/patches/ymodem-stream.patch
!/patches/README-ymodem.md
!/patches/README.md

# Optional Clash Verge bridge sources; build products remain local.
!/compat/
/compat/*
!/compat/clash-verge/
/compat/clash-verge/*
!/compat/clash-verge/bridge.rs
!/compat/clash-verge/verge_backend.rs
!/compat/clash-verge/make_patch.py
!/compat/clash-verge/verge-2.5.8.patch
!/compat/clash-verge/README.md
!/compat/clash-verge/test_client.py
!/compat/clash-verge/harness/
/compat/clash-verge/harness/*
!/compat/clash-verge/harness/Cargo.toml
!/compat/clash-verge/harness/Cargo.lock
!/compat/clash-verge/harness/src/
/compat/clash-verge/harness/src/*
!/compat/clash-verge/harness/src/main.rs

# Only the current release bundles stay in the working tree.
!/artifacts/
/artifacts/*
!/artifacts/pc-driver/
/artifacts/pc-driver/*
!/artifacts/pc-driver/maintenance-20261019-r1/
/artifacts/pc-driver/maintenance-20261019-r1/*
!/artifacts/pc-driver/maintenance-20261019-r1/XTE-Link.exe
!/artifacts/pc-driver/maintenance-20261019-r1/SHA256SUMS.txt
!/artifacts/pc-driver/maintenance-20261019-r1/build-requirements.txt
!/artifacts/pc-driver/maintenance-20261019-r1/使用说明.txt
!/artifacts/pc-driver/maintenance-20261019-r1/THIRD-PARTY-NOTICES.txt
!/artifacts/pc-driver/maintenance-20261019-r1/corresponding-source.zip
!/artifacts/pc-driver/maintenance-20261019-r1/manifest.json
!/artifacts/pc-driver/maintenance-20261019-r1/LICENSE-codex-mobile.txt
!/artifacts/pc-driver/maintenance-20261019-r1/LICENSE-ymodem.txt
!/artifacts/pc-driver/maintenance-20261019-r1/self-test.json
!/artifacts/firmware/
/artifacts/firmware/*
!/artifacts/firmware/maintenance-20261019/
/artifacts/firmware/maintenance-20261019/*
!/artifacts/firmware/maintenance-20261019/firmware.bin
!/artifacts/firmware/maintenance-20261019/SHA256SUMS.txt
!/artifacts/firmware/maintenance-20261019/manifest.json
!/artifacts/firmware/maintenance-20261019/VERIFICATION.md
