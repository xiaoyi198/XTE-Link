+bool SDCardManager::format() {
+  if (!initialized) return false;
+  const bool result = sd.format();
+  initialized = false;
+  return result;
+}
+
+bool SDCardManager::space(uint64_t& freeBytes, uint32_t& clusterBytes) {
+  if (!initialized) return false;
+  const int32_t clusters = static_cast<int32_t>(sd.freeClusterCount());
+  if (clusters < 0) return false;
+  clusterBytes = sd.bytesPerCluster();
+  freeBytes = static_cast<uint64_t>(clusters) * clusterBytes;
+  return clusterBytes != 0;
+}
